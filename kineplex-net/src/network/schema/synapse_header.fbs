// KinePlex Neurotransmitter header.
//
// This compact table is the fixed control header prepended to each future
// QUIC/UDP Spike payload. Fields are intentionally scalar and stable so readers
// can inspect them without deserializing the data-plane payload.
namespace kineplex.net;

/// Bit flags carried by a SynapseHeader.
///
/// Handshake (bit 0 / value 1): establishes or refreshes a synapse.
/// Backpressure (bit 1 / value 2): receiver asks the sender to reduce pressure.
/// EOF (bit 2 / value 4): this packet carries the final payload fragment.
enum SynapseFlag: uint8 {
  None = 0,
  Handshake = 1,
  Backpressure = 2,
  EOF = 4
}

table SynapseHeader {
  /// Identifier of the live execution graph.
  graph_id: uint64;
  /// Identifier of the graph edge/synapse carrying this Spike.
  synapse_id: uint64;
  /// Monotonic sequence number within the synapse.
  seq_num: uint64;
  /// Bitwise combination of SynapseFlag values.
  flags: SynapseFlag = None;
  /// Number of bytes following this header in the packet.
  payload_size: uint32;
}

root_type SynapseHeader;
file_identifier "KPXH";
